# Backend API base URL (must include the /api path segment).
# Leave empty in dev to use the Vite proxy (see VITE_DEV_PROXY_TARGET).
VITE_API_URL=

# Backend origin used by the Vite dev/preview proxy for /api requests.
VITE_DEV_PROXY_TARGET=http://localhost:5000

# Public path the app is served from. Use / locally or on a custom domain,
# and /<repo-name>/ on GitHub Pages project sites.
VITE_BASE_PATH=/
